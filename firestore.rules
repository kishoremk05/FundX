rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin'];
    } 
    
    function isBranchManager() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin', 'branch_manager', 'loan_officer'];
    }
    
    function isLoanOfficer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin', 'branch_manager', 'loan_officer', 'accountant'];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- User Profiles ---
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Branches ---
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Loan Products ---
    match /loan_products/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Loan Applications ---
    match /loan_applications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isLoanOfficer() || 
        (isAuthenticated() && resource.data.customer_id == request.auth.uid && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }
    
    // --- Loans ---
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // --- Repayment Schedules ---
    match /repayment_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // --- Repayments ---
    match /repayments/{repaymentId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // --- Accounts ---
    match /accounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Transactions ---
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // --- Expenses ---
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- Expense Categories ---
    match /expense_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Notes ---
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- Contacts ---
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // --- Contact Inquiries (Public form submissions) ---
    match /contact_inquiries/{document=**} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    // --- Settings ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Permissions ---
    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Subscriptions ---
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Coupons ---
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Coupon History ---
    match /coupon_history/{historyId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- Email Templates ---
    match /email_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Landing Page Content ---
    match /landing_page_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Email Settings ---
    match /email_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Security Settings ---
    match /security_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Storage Settings ---
    match /storage_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- SMS Settings ---
    match /sms_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Payment Gateway Settings ---
    match /payment_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- SMS Logs ---
    match /sms_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Email Logs ---
    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
