rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Safe admin check that doesn't fail if profile doesn't exist
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin'];
    }
    
    // Branch managers and above
    function isBranchManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin', 'branch_manager'];
    }
    
    // Loan officers and above (includes accountants)
    function isLoanOfficer() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin', 'branch_manager', 'loan_officer', 'accountant'];
    }
    
    // Staff member (any role except customer)
    function isStaff() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'Super_admin', 'branch_manager', 'loan_officer', 'accountant'];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // USER PROFILES
    // ============================================
    match /profiles/{userId} {
      // Anyone authenticated can read profiles
      allow read: if isAuthenticated();
      // Users can create/update their own profile, admins can manage all
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // BRANCH MANAGEMENT
    // ============================================
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // LOAN PRODUCTS / LOAN TYPES
    // ============================================
    match /loan_products/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Alternative collection name
    match /loan_types/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // FORMS SECTIONS
    // ============================================
    match /forms/{formId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isLoanOfficer());
      allow delete: if isAdmin();
    }

    // ============================================
    // LOAN APPLICATIONS
    // ============================================
    match /loan_applications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isLoanOfficer() || 
        (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow delete: if isAdmin();
    }
    
    // ============================================
    // LOANS
    // ============================================
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // ============================================
    // REPAYMENTS
    // ============================================
    match /repayment_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    match /repayments/{repaymentId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // ============================================
    // FINANCIAL ACCOUNTS & TRANSACTIONS
    // ============================================
    match /accounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // ============================================
    // EXPENSES
    // ============================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /expense_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // BORROWERS / CUSTOMERS
    // ============================================
    match /borrowers/{borrowerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isLoanOfficer() || isOwner(borrowerId);
      allow delete: if isAdmin();
    }
    
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isLoanOfficer() || isOwner(customerId);
      allow delete: if isAdmin();
    }

    // ============================================
    // NOTES & CONTACTS
    // ============================================
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Public contact form submissions
    match /contact_inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // ============================================
    // SETTINGS
    // ============================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /email_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /security_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /storage_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sms_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /payment_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // SUBSCRIPTIONS & COUPONS
    // ============================================
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /coupon_history/{historyId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // TEMPLATES & CONTENT
    // ============================================
    match /email_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /landing_page_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // LOGS
    // ============================================
    match /sms_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /email_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // ============================================
    // REPORTS
    // ============================================
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    // ============================================
    // USERS (for admin user management)
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // CATCH-ALL FOR ANY OTHER COLLECTIONS
    // This ensures new collections don't break the app
    // ============================================
    match /{collection}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
